# Copy to .env and adjust. Values here are read by BOTH the app (pydantic-settings)
# and docker compose. docker-compose.yml overrides DATABASE_URL / REDIS_URL /
# DOUYIN_DOWNLOADER_HOST for containers, so these values describe HOST usage.
#
# Do not put trailing "# comments" after a value - some parsers keep them.

# ---------- App ----------
APP_ENV=development

# ---------- Postgres ----------
POSTGRES_DB=media_depot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host-side connection. Compose publishes postgres on POSTGRES_HOST_PORT (5433),
# so point this at 5433 to talk to the containerised database from your Mac.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/media_depot

# ---------- Redis ----------
REDIS_URL=redis://localhost:6380/0

# ---------- External extraction services ----------
DOUYIN_DOWNLOADER_HOST=localhost
DOUYIN_DOWNLOADER_PORT=5555
XHS_DOWNLOADER_HOST=localhost
XHS_DOWNLOADER_PORT=5556

# ---------- Cookies ----------
# Browser to extract cookies from on the host: edge, chrome, firefox, safari, ...
# Containers override this to "none" and read COOKIES_FILE instead.
COOKIES_FROM_BROWSER=edge
COOKIES_REFRESH_INTERVAL=3600

# ---------- Published host ports (compose only) ----------
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
DOUYIN_HOST_PORT=5555

# DouK-Downloader image for the douyin service. Pulled from the project's own
# registry - no local checkout needed. Do NOT use :latest (still 5.7), which
# binds its API to 127.0.0.1 inside the container and is unreachable.
DOUYIN_IMAGE=ghcr.io/joeanamier/tiktok-downloader:5.8-dev
